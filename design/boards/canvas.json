   "page": "home",
   "fill": "blue"
  },
  "m_about": {
   "x": -520,
   "y": 0,
   "text": "Motion: sections reveal on scroll; stats count up on enter (2017 counts from 2000). Concept cards lift on hover.",
   "w": 400,
   "page": "about",
   "fill": "blue"
  },
  "m_menu": {
   "x": -520,
   "y": 0,
   "text": "Interactive: chips filter categories, search filters by name/description (empty state included). Chip bar sticks under the shrunk header. Pizza & Pasta items are placeholders until the cafe confirms them.",
   "w": 400,
   "page": "menu",
   "fill": "blue"
  },
  "m_experience": {
   "x": -520,
   "y": 0,
   "text": "Motion: alternating sections reveal; image zooms 1.05 on hover. Mobile stacks image above text.",
   "w": 400,
   "page": "experience",
   "fill": "blue"
  },
  "m_gallery": {
   "x": -520,
   "y": 0,
   "text": "Interactive: filter chips + tap a tile to open the lightbox (prev/next/close). Build: Esc closes, arrows navigate, swipe on mobile, focus trapped in dialog.",
